{
  "name": "rekansiaga-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:mvp": "node --test scripts/test-mvp.mjs scripts/test-report-gateway.mjs scripts/test-admin-data.mjs",
    "test:preflight": "python scripts/test-live-sql.py && node scripts/test-preflight-runtime.mjs && node --test scripts/test-gateway-config.mjs scripts/test-report-gateway.mjs && tsc -p tsconfig.edge.json",
    "typecheck:edge": "tsc -p tsconfig.edge.json",
    "test:dev-live": "node scripts/test-dev-live.mjs",
    "test:regions-ui": "node --test scripts/test-region-selector.mjs",
    "test:featured-article": "node scripts/test-featured-article.mjs",
    "test:location-alerts": "node scripts/test-location-alerts.mjs",
    "test:sos-relay": "node scripts/test-sos-relay.mjs",
    "test:stage-e": "node --test scripts/test-stage-e.mjs scripts/test-mvp.mjs scripts/test-admin-data.mjs scripts/test-report-review-scope.mjs",
    "test:stage-e-browser": "node scripts/test-stage-e-browser.mjs",
    "test:report-review": "node --test scripts/test-report-review-scope.mjs",
    "regions:validate": "node scripts/validate-regions.mjs",
    "regions:seed-sql": "node scripts/seed-regions.mjs",
    "regions:convert": "python scripts/convert-regions.py",
    "qa:mvp": "node scripts/smoke-live-admin-browser.mjs",
    "check:dev": "node scripts/probe-dev-readonly.mjs --live-readonly",
    "flutter:config": "node scripts/prepare-flutter-config.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
