# Server-only template. Never prefix these with VITE_ or place them in browser code.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the Supabase runtime.
REPORT_GATEWAY_ENABLED=false
REPORT_PUBLIC_KEY=replace_with_dev_publishable_key
REPORT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TURNSTILE_SECRET_KEY=replace_on_server_only
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
# Temporary dev-global quota uses a fixed server bucket in the existing DB RPC.
# Shared limits: 5 submit / 30 track per fixed 600-second slot. No IP identity.
# REPORT_RATE_HMAC_KEY and REPORT_TRUSTED_IP_HEADER are not required or read.
# Existing stored values may remain; they cannot change/reset the quota bucket.
