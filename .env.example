# MAIN DEVELOPMENT DATABASE only. Copy to .env.local, never use staging here.
VITE_SUPABASE_URL=https://uiuiouosblyuqgnvfpeh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_dev_publishable_key
# Leave false until operator approves exact demo rows/actions AND verifies dev RLS/grants.
# This is an operational guard, not server authorization.
VITE_DEV_ARTICLE_WRITES_APPROVED=false

# Broader admin mutations require scoped operator approval and verified dev RLS.
VITE_DEV_REMOTE_WRITES_APPROVED=false
# Stage E content workflow only; enable after approval of the Cloud test package.
# Includes source dependencies for disasters; excludes settings, staff and notifications.
VITE_DEV_CONTENT_WRITES_ENABLED=false
# Routine report review via existing RPC for verified staff on dev only.
# Other Admin writes remain controlled by their existing guards.
VITE_DEV_REPORT_REVIEW_ENABLED=false
VITE_PUBLIC_REPORT_PHOTO_APPROVAL_ENABLED=false
# Optional approval for review RPC on ONE chosen dev report only.
# When true, this narrower scope takes precedence over routine review.
VITE_DEV_REPORT_REVIEW_APPROVED=false
VITE_DEV_REPORT_REVIEW_ID=
# Enable only after approved SQL, bucket, gateway deployment and CAPTCHA configuration.
VITE_REPORT_GATEWAY_ENABLED=false
VITE_TURNSTILE_SITE_KEY=

# Two proposed public-text settings only; enable after backend allowlist approval.
VITE_PUBLIC_CONFIG_ENABLED=false

# Enable only after the approved single-tracking-v2 backend deployment.
VITE_REPORT_SINGLE_CODE_ENABLED=false
# Enable only after list_public_verified_report_map is deployed and postflight-checked.
VITE_PUBLIC_VERIFIED_REPORT_MAP_ENABLED=false

# Enable after approved integrated content SQL + article-media deployment.
VITE_INTEGRATED_CONTENT_ENABLED=false
# Enable only after the approved featured-article SQL is deployed and postflight passes.
VITE_FEATURED_ARTICLE_ENABLED=false

# SOS relay/admin are separate switches. Enable only after the approved SOS SQL
# package and Edge Function pass postflight and the operator completes acceptance.
VITE_SOS_RELAY_ENABLED=false
VITE_SOS_ADMIN_ENABLED=false
